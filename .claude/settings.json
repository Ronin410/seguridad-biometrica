{
  "extraKnownMarketplaces": {
    "alejandro-agentes": {
      "source": {
        "source": "github",
        "repo": "ronin410/agentes"
      }
    }
  },
  "enabledPlugins": {
    "agentes@alejandro-agentes": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/instalar-agentes.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
