# Copia este archivo a .env (junto a docker-compose.yml) para personalizar
# las credenciales de AWS y el JWT_SECRET que usará el backend en Docker.
# Sin AWS configurado, el servidor arranca igual — solo fallan el
# enrolamiento facial y el marcaje por cámara (usa el registro manual).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
JWT_SECRET=cambia-esta-clave-por-una-segura
TZ_NEGOCIO=America/Mazatlan
SIMILARITY_THRESHOLD=95
